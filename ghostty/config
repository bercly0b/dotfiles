term = xterm-256color

macos-option-as-alt = true

keybind = cmd+k=text:\u{1b}k

cursor-style = block
shell-integration-features = no-cursor

font-family = Fira Code
font-style = Medium
font-size = 18

# Theme switch for the whole setup: Catppuccin Latte (light) or Mocha (dark).
# nvim, tmux and fzf read this line to pick the same flavor.
theme = Catppuccin Latte
