term = xterm-256color

macos-option-as-alt = true

keybind = cmd+k=text:\u{1b}k

cursor-style = block
shell-integration-features = no-cursor

font-family = Iosevka NFM Medium
font-size = 18

# Light/dark switch for the whole setup: tmux, zsh and fzf use this palette,
# nvim parses this line (lua/theme.lua)
theme = Flexoki Light
